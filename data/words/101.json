[[["ٱلْقَارِعَةُ","The Striking Calamity","al-qāriʿatu"]],[["مَا","What","mā"],["ٱلْقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu"]],[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","will make you know","adrāka"],["مَا","what","mā"],["ٱلْقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu"]],[["يَوْمَ","(The) Day","yawma"],["يَكُونُ","will be","yakūnu"],["ٱلنَّاسُ","the mankind","l-nāsu"],["كَٱلْفَرَاشِ","like moths","kal-farāshi"],["ٱلْمَبْثُوثِ","scattered","l-mabthūthi"]],[["وَتَكُونُ","And will be","watakūnu"],["ٱلْجِبَالُ","the mountains","l-jibālu"],["كَٱلْعِهْنِ","like wool","kal-ʿih'ni"],["ٱلْمَنفُوشِ","fluffed up","l-manfūshi"]],[["فَأَمَّا","Then as for","fa-ammā"],["مَن","(him) whose","man"],["ثَقُلَتْ","(are) heavy","thaqulat"],["مَوَٰزِينُهُۥ","his scales","mawāzīnuhu"]],[["فَهُوَ","Then he","fahuwa"],["فِى","(will be) in","fī"],["عِيشَةٍۢ","a life","ʿīshatin"],["رَّاضِيَةٍۢ","pleasant","rāḍiyatin"]],[["وَأَمَّا","But as for","wa-ammā"],["مَنْ","(him) whose","man"],["خَفَّتْ","(are) light","khaffat"],["مَوَٰزِينُهُۥ","his scales","mawāzīnuhu"]],[["فَأُمُّهُۥ","His abode","fa-ummuhu"],["هَاوِيَةٌۭ","(will be the) Pit","hāwiyatun"]],[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","will make you know","adrāka"],["مَا","what","mā"],["هِيَهْ","it is","hiyah"]],[["نَارٌ","A Fire","nārun"],["حَامِيَةٌۢ","intensely hot","ḥāmiyatun"]]]